# RE:VENANT Configuration
# Local Ollama Inference Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Request timeout in milliseconds (default: 120000ms = 120s for CPU generation)
OLLAMA_TIMEOUT_MS=120000

# Maximum file scan limit (default: 500)
MAX_SCAN_FILES=500

# Maximum single file size in bytes (default: 256000 = 250KB)
MAX_FILE_SIZE_BYTES=256000
